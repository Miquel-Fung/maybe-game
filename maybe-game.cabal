cabal-version:   3.0
name:            maybe-game
version:         0.1.0.0

-- synopsis:
-- description:
license:         GPL-3.0-or-later
license-file:    LICENSE
author:          Miquel-Fung
maintainer:      fungmiquel@gmail.com

-- copyright:
build-type:      Simple
extra-doc-files: CHANGELOG.md

-- extra-source-files:

common warnings
  ghc-options: -Wall

executable maybe-game
  import:           warnings
  main-is:          Main.hs
  other-modules:
    Draw
    Game
    Physics
    Shape

  -- other-extensions:
  build-depends:
    , base       >=4    && <5
    , h-raylib   >=5    && <7
    , hslua      >=2    && <3
    , linear     >=1    && <1.24
    , microlens  >=0.4  && <0.6
    , vector     >=0.12 && <0.14

  hs-source-dirs:   src
  default-language: Haskell2010
